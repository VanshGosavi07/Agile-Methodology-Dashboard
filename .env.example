# Database Configuration
DATABASE_URL=your_database_url_here

# Secret Key for Session Management
SECRET_KEY=your_secret_key_here

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Secondary Email Account (for send_emails_to_users function)
SECONDARY_EMAIL=your_secondary_email@gmail.com
SECONDARY_EMAIL_PASSWORD=your_secondary_app_password_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Recipient Email for Reports
REPORT_RECIPIENT_EMAIL=your_report_recipient@gmail.com

# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=production

# Database Configuration
# For local development, leave this empty to use SQLite
# For production, use your database URL (PostgreSQL, MySQL, etc.)
DATABASE_URL=

# Email Configuration (for yagmail)
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password

# Vercel Environment (automatically set by Vercel)
VERCEL_ENV=

# Optional: Debug mode (set to False in production)
FLASK_DEBUG=False
